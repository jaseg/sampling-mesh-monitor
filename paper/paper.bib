@inproceedings{krachenfelsRealWorldSnapshotsVs2021,
  title = {Real-{{World Snapshots}} vs. {{Theory}}: {{Questioning}} the t-{{Probing Security Model}}},
  shorttitle = {Real-{{World Snapshots}} vs. {{Theory}}},
