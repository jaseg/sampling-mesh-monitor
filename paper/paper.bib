  booktitle = {Proceedings of the 2020 {{Workshop}} on {{Privacy-Preserving Machine Learning}} in {{Practice}}},
  author = {Hussain, Siam and Li, Baiyu and Koushanfar, Farinaz and Cammarota, Rosario},
